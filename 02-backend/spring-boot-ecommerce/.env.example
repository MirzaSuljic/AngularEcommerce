# Copy this file to ".env" (same folder) and fill in your values. ".env" is not committed to git.
# Neon: console.neon.tech -> your project -> Connect (connection pooling OFF, host without "-pooler")
ECOMMERCE_DB_URL=jdbc:postgresql://YOUR-NEON-HOST.eu-central-1.aws.neon.tech/ecommerce?sslmode=require&channel_binding=require
ECOMMERCE_DB_USERNAME=neondb_owner
ECOMMERCE_DB_PASSWORD=your-neon-password

# at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
